<?xml version="1.0" encoding="utf-8"?>
<!--
    アプリアイコンの前景。Stitch のロゴ（Precision Matrix Logo）をベクタで描き直したもの。
    ">" のシェブロン、"_" のカーソル、右上の点の 3 つで構成する。
    アダプティブアイコンは端末ごとに外形が円や角丸に切り抜かれるため、
    図形はすべて中央の安全領域（直径 66dp）の内側に収めている。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ">" のシェブロン -->
    <path
        android:pathData="M34,43L49.5,55L34,67"
        android:strokeColor="#00F0FF"
        android:strokeWidth="6.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- "_" のカーソル -->
    <path
        android:pathData="M53,67L73.5,67"
        android:strokeColor="#00F0FF"
        android:strokeWidth="6.2"
        android:strokeLineCap="round" />

    <!-- 右上の点 -->
    <path
        android:fillColor="#00F0FF"
        android:pathData="M71.4,42.8m-4.3,0a4.3,4.3 0,1 1,8.6 0a4.3,4.3 0,1 1,-8.6 0" />
</vector>
